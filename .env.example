# Free-tier friendly: Neon (neon.tech) or Supabase both offer a free Postgres
# instance that's sufficient for a showcase build.
DATABASE_URL="postgresql://user:password@host:5432/oms?schema=public"
PORT=3000

# Change this in any real deployment.
JWT_SECRET="dev-secret-change-me"

# Required for the Agent module (Purchase Agent narration / tool-use loop).
# Get one at https://console.anthropic.com — usage is pay-per-call, which
# suits a low-recurring-cost setup (no idle cost when the agent isn't used).
ANTHROPIC_API_KEY=""
